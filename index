    <!-- JAVASCRIPT LOGIC -->
    <script>
        let activeMainTab = 'minuman';
        let activeCategory = 'all-minuman';
        let searchQuery = '';
        let currentTable = APP_CONFIG.defaultTable;
        let cart = [];
        let toastTimeout = null;
        let selectedItem = null;
        let modalQty = 1;
        let selectedOptions = {};

        window.addEventListener('DOMContentLoaded', () => {
            initApp();
        });

        function initApp() {
            document.getElementById('store-title').textContent = APP_CONFIG.storeName;
            document.getElementById('store-sub').textContent = APP_CONFIG.storeSub;
            document.getElementById('store-tagline').textContent = APP_CONFIG.tagline;
            
            detectTableFromURL();
            setupTableSelector();
            renderCategories();
            renderMenuGrid();
            
            document.getElementById('search-input').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                renderMenuGrid();
            });
        }

        // LEVEL 1 TAB SWITCHING LOGIC
        function switchMainTab(tabName) {
            activeMainTab = tabName;
            activeCategory = tabName === 'minuman' ? 'all-minuman' : 'all-makanan';
            searchQuery = '';
            document.getElementById('search-input').value = '';

            const btnMinuman = document.getElementById('tab-minuman');
            const btnMakanan = document.getElementById('tab-makanan');

            if(tabName === 'minuman') {
                btnMinuman.className = "flex-1 pb-2 text-center font-heading font-bold text-sm border-b-2 transition-colors border-captain-cyan text-captain-cyan";
                btnMakanan.className = "flex-1 pb-2 text-center font-heading font-bold text-sm border-b-2 transition-colors border-transparent text-slate-400 hover:text-slate-600";
            } else {
                btnMakanan.className = "flex-1 pb-2 text-center font-heading font-bold text-sm border-b-2 transition-colors border-captain-cyan text-captain-cyan";
                btnMinuman.className = "flex-1 pb-2 text-center font-heading font-bold text-sm border-b-2 transition-colors border-transparent text-slate-400 hover:text-slate-600";
            }

            renderCategories();
            renderMenuGrid();
        }

        function detectTableFromURL() {
            const urlParams = new URLSearchParams(window.location.search);
            const tableParam = urlParams.get('table') || urlParams.get('meja');
            if (tableParam) {
                const parsedNum = parseInt(tableParam, 10);
                if (!isNaN(parsedNum) && parsedNum >= 1 && parsedNum <= APP_CONFIG.totalTables) {
                    currentTable = String(parsedNum).padStart(2, '0');
                }
            }
        }

        function setupTableSelector() {
            const selector = document.getElementById('table-selector');
            selector.innerHTML = '';
            for (let i = 1; i <= APP_CONFIG.totalTables; i++) {
                const numStr = String(i).padStart(2, '0');
                const option = document.createElement('option');
                option.value = numStr;
                option.textContent = `Meja ${numStr}`;
                if (numStr === currentTable) option.selected = true;
                selector.appendChild(option);
            }
            selector.addEventListener('change', (e) => {
                currentTable = e.target.value;
                updateCartBadge();
                showToast(`Lokasi diubah: Meja ${currentTable}`);
            });
        }

        function formatRupiah(amount) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(amount).replace('Rp', 'Rp ');
        }

        function extractExtraPrice(optionValue) {
            if (!optionValue) return 0;
            const match = String(optionValue).match(/\+\s*(\d+)/);
            return match ? parseInt(match[1], 10) : 0;
        }

        function calculateCurrentUnitPrice() {
            if (!selectedItem) return 0;
            let extra = 0;
            for (const val of Object.values(selectedOptions)) {
                extra += extractExtraPrice(val);
            }
            return selectedItem.price + extra;
        }

        function toggleBodyScroll(lock) {
            if (lock) document.body.classList.add('overflow-hidden');
            else document.body.classList.remove('overflow-hidden');
        }

        function renderCategories() {
            const container = document.getElementById('category-container');
            const categoriesToRender = APP_CONFIG.categories[activeMainTab];

            container.innerHTML = categoriesToRender.map(cat => {
                const isActive = cat.id === activeCategory;
                return `
                    <button onclick="selectCategory('${cat.id}')" 
                        class="whitespace-nowrap px-3.5 py-1.5 rounded-full text-xs font-heading font-bold flex items-center gap-2 transition-all tap-highlight-transparent ${
                            isActive 
                            ? 'bg-captain-cyan text-white shadow-sm shadow-captain-cyan/30' 
                            : 'bg-white text-captain-navy hover:border-captain-cyan border border-slate-200'
                        }">
                        <i class="fa-solid ${cat.icon} text-[11px] ${isActive ? 'text-white' : 'text-captain-cyan'}"></i>
                        <span>${cat.name}</span>
                    </button>
                `;
            }).join('');
        }

        function selectCategory(catId) {
            activeCategory = catId;
            renderCategories();
            
            const catObj = APP_CONFIG.categories[activeMainTab].find(c => c.id === catId);
            document.getElementById('current-category-title').textContent = catObj ? catObj.name : 'Daftar Menu';
            
            renderMenuGrid();
        }

        function renderMenuGrid() {
            const grid = document.getElementById('menu-grid');
            const emptyState = document.getElementById('empty-state');
            
            const filtered = APP_CONFIG.menuItems.filter(item => {
                const matchesMainTab = item.mainTab === activeMainTab;
                const matchesCategory = activeCategory.startsWith('all-') || item.category === activeCategory;
                const matchesSearch = item.name.toLowerCase().includes(searchQuery) || item.description.toLowerCase().includes(searchQuery);
                return matchesMainTab && matchesCategory && matchesSearch;
            });

            document.getElementById('menu-count-badge').textContent = `Tersedia: ${filtered.length} Menu`;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            grid.innerHTML = filtered.map(item => {
                const isBestSeller = item.badge && item.badge.toLowerCase().includes('best');
                const badgeClass = isBestSeller ? 'bg-captain-pink text-white' : 'bg-captain-cyan text-white';
                return `
                <div onclick="openItemModal('${item.id}')" class="stitch-card rounded-2xl p-3 flex gap-3.5 items-center hover:border-captain-cyan/50 active:scale-[0.99] transition-all cursor-pointer">
                    <div class="relative w-24 h-24 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-100">
                        <img src="${item.image}" alt="${item.name}" loading="lazy" class="w-full h-full object-cover">
                        ${item.badge ? `<span class="absolute top-1.5 left-1.5 ${badgeClass} text-[9px] font-mono font-bold uppercase px-2 py-0.5 rounded-full shadow-xs">${item.badge}</span>` : ''}
                    </div>
                    <div class="flex-1 min-w-0 flex flex-col justify-between h-full py-0.5">
                        <div>
                            <h3 class="font-heading font-bold text-base text-slate-800 truncate leading-snug">${item.name}</h3>
                            <p class="text-[11px] text-slate-500 line-clamp-2 mt-0.5 leading-relaxed">${item.description}</p>
                        </div>
                        <div class="flex justify-between items-center mt-2.5">
                            <span class="font-mono font-bold text-sm text-captain-cyan">${formatRupiah(item.price)}</span>
                            <button class="bg-captain-cyanLight hover:bg-captain-cyan text-captain-cyan hover:text-white w-7 h-7 rounded-lg border border-captain-cyan/20 flex items-center justify-center transition-colors">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `}).join('');
        }

        function resetSearch() {
            searchQuery = '';
            document.getElementById('search-input').value = '';
            selectCategory(activeMainTab === 'minuman' ? 'all-minuman' : 'all-makanan');
        }

        function openItemModal(itemId) {
            selectedItem = APP_CONFIG.menuItems.find(i => i.id === itemId);
            if (!selectedItem) return;
            modalQty = 1;
            selectedOptions = {};
            
            document.getElementById('modal-img').src = selectedItem.image;
            document.getElementById('modal-title').textContent = selectedItem.name;
            document.getElementById('modal-desc').textContent = selectedItem.description;
            document.getElementById('modal-qty').textContent = modalQty;
            document.getElementById('modal-note').value = '';
            
            const badgeEl = document.getElementById('modal-badge');
            if (selectedItem.badge) {
                badgeEl.textContent = selectedItem.badge;
                badgeEl.classList.remove('hidden');
            } else {
                badgeEl.classList.add('hidden');
            }
            
            renderModalOptions();
            updateModalPriceAndButton();
            
            const modal = document.getElementById('item-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.children[0].classList.remove('scale-95');
            modal.children[0].classList.add('scale-100');
            toggleBodyScroll(true);
        }

        function renderModalOptions() {
            const container = document.getElementById('modal-options-container');
            container.innerHTML = '';
            if (!selectedItem.options || Object.keys(selectedItem.options).length === 0) {
                container.classList.add('hidden');
                return;
            }
            container.classList.remove('hidden');
            
            const optionLabels = {
                serv: 'Penyajian (Serving)',
                beans: 'Pilihan Biji Kopi',
                pedas: 'Tingkat Kepedasan',
                sugar: 'Tingkat Kemanisan',
                ice: 'Takaran Es'
            };
            for (const [key, values] of Object.entries(selectedItem.options)) {
                if (!values || values.length === 0) continue;
                selectedOptions[key] = values[0];
                const labelText = optionLabels[key.toLowerCase()] || key;
                const group = document.createElement('div');
                group.className = 'space-y-1.5';
                group.innerHTML = `
                    <label class="block text-[11px] font-heading font-bold text-captain-navy uppercase tracking-wider">${labelText}</label>
                    <div class="grid grid-cols-${values.length > 2 ? '3' : '2'} gap-2">
                        ${values.map(val => `
                            <button type="button" onclick="selectOption('${key}', '${val}', this)" 
                                class="option-btn-${key} text-xs py-2 px-2.5 rounded-xl transition-all font-mono ${
                                    val === selectedOptions[key]
                                    ? 'bg-captain-cyan text-white font-bold shadow-xs'
                                    : 'bg-slate-50 border border-slate-200 text-slate-600 font-medium hover:border-captain-cyan'
                                }">
                                ${val}
                            </button>
                        `).join('')}
                    </div>
                `;
                container.appendChild(group);
            }
        }

        function selectOption(groupKey, value, btnEl) {
            selectedOptions[groupKey] = value;
            const buttons = document.querySelectorAll(`.option-btn-${groupKey}`);
            buttons.forEach(b => {
                b.className = `option-btn-${groupKey} text-xs py-2 px-2.5 rounded-xl transition-all font-mono bg-slate-50 border border-slate-200 text-slate-600 font-medium hover:border-captain-cyan`;
            });
            btnEl.className = `option-btn-${groupKey} text-xs py-2 px-2.5 rounded-xl transition-all font-mono bg-captain-cyan text-white font-bold shadow-xs`;
            updateModalPriceAndButton();
        }

        function changeModalQty(delta) {
            if (modalQty + delta >= 1) {
                modalQty += delta;
                document.getElementById('modal-qty').textContent = modalQty;
                updateModalPriceAndButton();
            }
        }

        function updateModalPriceAndButton() {
            if (!selectedItem) return;
            const unitPrice = calculateCurrentUnitPrice();
            const total = unitPrice * modalQty;
            document.getElementById('modal-price').textContent = formatRupiah(unitPrice);
            document.getElementById('modal-add-btn-text').textContent = `Tambah ke Pesanan - ${formatRupiah(total)}`;
        }

        function closeItemModal() {
            const modal = document.getElementById('item-modal');
            modal.children[0].classList.remove('scale-100');
            modal.children[0].classList.add('scale-95');
            modal.classList.add('opacity-0', 'pointer-events-none');
            toggleBodyScroll(false);
        }

        function confirmAddToCart() {
            if (!selectedItem) return;
            const note = document.getElementById('modal-note').value.trim();
            const optionString = Object.values(selectedOptions).join(', ');
            const finalUnitPrice = calculateCurrentUnitPrice();
            const existingIndex = cart.findIndex(c => c.id === selectedItem.id && c.options === optionString && c.note === note);
            if (existingIndex > -1) {
                cart[existingIndex].qty += modalQty;
            } else {
                cart.push({
                    cartItemId: Date.now() + Math.random().toString(),
                    id: selectedItem.id,
                    name: selectedItem.name,
                    price: finalUnitPrice,
                    qty: modalQty,
                    options: optionString,
                    note: note
                });
            }
            closeItemModal();
            updateCartBadge();
            showToast(`${selectedItem.name} ditambahkan!`);
        }

        function updateCartBadge() {
            const floatingBar = document.getElementById('floating-cart-bar');
            const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            if (totalItems > 0) {
                document.getElementById('cart-badge-count').textContent = totalItems;
                document.getElementById('cart-item-summary').textContent = `${totalItems} Item • Meja ${currentTable}`;
                document.getElementById('cart-total-price').textContent = formatRupiah(totalPrice);
                floatingBar.classList.remove('translate-y-full');
            } else {
                floatingBar.classList.add('translate-y-full');
            }
        }

        function openCartModal() {
            if (cart.length === 0) return;
            document.getElementById('cart-table-badge').textContent = `Meja ${currentTable}`;
            renderCartList();
            const modal = document.getElementById('cart-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.children[0].classList.remove('scale-95');
            modal.children[0].classList.add('scale-100');
            toggleBodyScroll(true);
        }

        function closeCartModal() {
            const modal = document.getElementById('cart-modal');
            modal.children[0].classList.remove('scale-100');
            modal.children[0].classList.add('scale-95');
            modal.classList.add('opacity-0', 'pointer-events-none');
            toggleBodyScroll(false);
        }

        function renderCartList() {
            const container = document.getElementById('cart-items-list');
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            document.getElementById('cart-final-total').textContent = formatRupiah(totalPrice);
            container.innerHTML = cart.map(item => `
                <div class="stitch-card p-3.5 rounded-2xl flex justify-between items-start gap-3">
                    <div class="flex-1 min-w-0">
                        <h5 class="font-heading font-bold text-sm text-slate-800">${item.name}</h5>
                        ${item.options ? `<p class="text-[11px] font-mono text-captain-cyan font-semibold mt-0.5">${item.options}</p>` : ''}
                        ${item.note ? `<p class="text-[11px] text-slate-500 bg-slate-50 border border-slate-200/80 rounded-lg px-2.5 py-1 mt-1.5"><i class="fa-regular fa-note-sticky text-[10px] text-captain-pink me-1"></i>${item.note}</p>` : ''}
                        <p class="text-xs font-mono font-bold text-captain-pink mt-1.5">${formatRupiah(item.price * item.qty)}</p>
                    </div>
                    <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl p-1">
                        <button onclick="updateCartItemQty('${item.cartItemId}', -1)" class="w-6 h-6 rounded-lg bg-white text-slate-600 border border-slate-200 hover:border-captain-pink flex items-center justify-center">
                            <i class="fa-solid fa-minus text-[10px]"></i>
                        </button>
                        <span class="w-4 text-center font-mono font-bold text-xs text-slate-800">${item.qty}</span>
                        <button onclick="updateCartItemQty('${item.cartItemId}', 1)" class="w-6 h-6 rounded-lg bg-captain-cyan text-white hover:bg-captain-cyanDark flex items-center justify-center">
                            <i class="fa-solid fa-plus text-[10px]"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function updateCartItemQty(cartItemId, delta) {
            const index = cart.findIndex(item => item.cartItemId === cartItemId);
            if (index > -1) {
                cart[index].qty += delta;
                if (cart[index].qty <= 0) cart.splice(index, 1);
            }
            updateCartBadge();
            if (cart.length === 0) closeCartModal();
            else renderCartList();
        }

        function sendOrderToWhatsApp() {
            const customerName = document.getElementById('customer-name').value.trim();
            if (!customerName) {
                showToast("Silakan isi nama Anda sebelum memesan!");
                document.getElementById('customer-name').focus();
                return;
            }
            if (cart.length === 0) return;
            let message = `*[PESANAN BARU - MEJA ${currentTable}]*\nNama Pemesan: ${customerName}\n\n*Detail Pesanan:*\n`;
            let totalPrice = 0;
            cart.forEach((item, idx) => {
                const subtotal = item.price * item.qty;
                totalPrice += subtotal;
                const optText = item.options ? ` (${item.options})` : '';
                message += `${idx + 1}. ${item.qty}x *${item.name}*${optText} - ${formatRupiah(subtotal)}\n`;
                if (item.note) message += `   └ Catatan: _${item.note}_\n`;
            });
            message += `\n*Total Pembayaran:* *${formatRupiah(totalPrice)}*\n\nMohon konfirmasi pesanan ini di kasir. Terima kasih!`;
            window.open(`https://wa.me/${APP_CONFIG.whatsappNumber}?text=${encodeURIComponent(message)}`, '_blank');
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = message;
            if (toastTimeout) clearTimeout(toastTimeout);
            toast.classList.remove('opacity-0', '-translate-y-5', 'pointer-events-none');
            toastTimeout = setTimeout(() => { toast.classList.add('opacity-0', '-translate-y-5', 'pointer-events-none'); }, 2800);
        }
    </script>
</body>
</html>
